{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/analyze",
      "destination": "/api/analyze"
    },
    {
      "source": "/api/report",
      "destination": "/api/report"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
